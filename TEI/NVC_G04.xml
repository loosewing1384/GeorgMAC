        <!-- inicio fragmento vv. 4.511-515 -->
        <l resp="#NVC" xml:id="wj4_r52_p2c" source="#d1e1706"
          corresp="511">
          <!-- qualis populea maerens philomela sub umbra-->
          cual el ruiseñor/la Filomela que, 
          lamentándose bajo 
          la sombra alamera,
        </l>
        
        
        <l resp="#NVC" xml:id="ogs_r52_p2c" source="#d1e1709"
          corresp="512">
          <!-- amissos queritur fetus, quos durus arator-->
          se queja de sus crías perdidas,
          que el duro labrador,
        </l>
        
        <l resp="#NVC" xml:id="k4b_s52_p2c" source="#d1e1712"
          corresp="513">
          <!-- observans nido implumes detraxit; at illa-->
          vigilando,
          las sustrajo implumes de su nido;
          mas ella
        </l>
        
        
        <l resp="#NVC" xml:id="sy2_s52_p2c" source="#d1e1715"
          corresp="514">
          <!-- flet noctem ramoque sedens miserabile carmen -->
          llora durante la noche,
          y sentada en una rama, 
          su miserable canto
        </l>
        
        
        <l resp="#NVC" xml:id="apj_s52_p2c" source="#d1e1719"
          corresp="515">
          <!-- integrat et maestis late loca 
            questibus implet.-->
          renueva/reintegra, <!--integrat-->
          y con/de sus tristes quejidos 
          llena los lugares por doquier.
        </l>
        
        
        <!-- fin fragmento vv.4.511-4.515-->
